# Server
PORT=3000

# Built-in test webhooks (example, open, gated under webhooks/).
# true/1/yes keeps them from being discovered: requests then 404 like
# unknown webhooks and they disappear from the startup log and the
# dashboard. Unset/empty keeps the current behaviour (tests are served).
DISABLE_TEST_WEBHOOKS=

# Database (split parts; docker-compose.yml uses the same variables.
# An explicit DATABASE_URL, if set, overrides these.)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=webhook
DB_SCHEMA=public

# Logging: comma-separated sinks: stdout | file | logstash
LOG_SINKS=stdout
LOG_LEVEL=info
LOG_FILE=./logs/webhook-engine.log
LOGSTASH_URL=http://127.0.0.1:9200/_bulk

# Generic auth (applies to /api/* and to webhooks whose config.json has
# "useGlobalAuth": true; webhooks with their own auth(ctx) or without the
# opt-in flag are unaffected and stay open).
# bearer | hmac | hmac,bearer  — empty value disables generic auth entirely
# (the engine then lists all open endpoints in the startup log).
AUTH_MODE=bearer
AUTH_BEARER_TOKEN=dev-token-change-me
AUTH_HMAC_SECRETS=

# Webhook module secrets do NOT belong here. Each module keeps its settings and
# credentials in webhooks/<name>/config.json — it reads its webhook secrets and
# API tokens from there, so the module is self-contained. The engine
# masks secret-looking config keys before handing a config to the dashboard
# (redactConfig in src/app.js). env vars are only a fallback for deployments that
# keep credentials out of git; each *Comment key in a module config names the var
# it consults, and config.json always wins.
