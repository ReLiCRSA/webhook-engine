# Server
PORT=3000

# Database (split parts; docker-compose.yml uses the same variables)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=webhook
DB_SCHEMA=public
# Explicit DATABASE_URL (if set) overrides the split vars.

# Logging: comma-separated sinks: stdout | file | logstash
LOG_SINKS=stdout
LOG_LEVEL=info
LOG_FILE=./logs/webhook-engine.log
LOGSTASH_URL=http://127.0.0.1:9200/_bulk

# Generic auth (applies to endpoints without their own auth, and to /api/*).
# bearer | hmac | hmac,bearer  — empty value disables generic auth entirely
# (endpoints without their own auth then stay open; the startup log lists them).
AUTH_MODE=bearer
AUTH_BEARER_TOKEN=dev-token-change-me
AUTH_HMAC_SECRETS=
