node_modules/
.env
.env.local
.vscode/

# assembled Prisma schema (build output of npm run prisma:generate)
prisma/generated/

# graphify knowledge graph (local build output)
graphify-out/

# generated module test payloads (contain real workspace ids/emails) —
# unanchored pattern, matches test-payloads/ at any depth (e.g. inside a webhook)
test-payloads/

# webhooks: keep only the project ones (example, open, gated, pb-lin-sync)
webhooks/*
!webhooks/example/
!webhooks/open/
!webhooks/gated/
