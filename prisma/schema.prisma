// Prisma schema for the webhook engine.
// All database access goes through Prisma — never hand-written SQL.
// See README.md for field meaning and how modules can use the shared client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per webhook invocation (including auth failures and unknown webhooks).
model WebhookCall {
  id         BigInt   @id @default(autoincrement())
  /// Webhook name (directory under webhooks/). For unknown routes this is the
  /// requested name.
  webhook    String
  method     String
  /// Full request URL path, e.g. /webhook/example
  path       String
  /// Parsed query parameters, e.g. {"test":"hello"}. Null when no query string.
  query      Json?
  /// A snapshot of selected request headers (lower-cased names).
  headers    Json?
  /// Parsed body, same shape as the handler receives:
  /// { url: {...}, post: {...}, json: {...}|null, raw: "string" }
  body       Json?
  status     Int
  /// none | generic | module | denied — how (or whether) the call was authenticated.
  auth       String   @default("none")
  durationMs Int?
  /// Set when this call was created by replaying another call (id of the
  /// parent row; chains of replay-of-replay point at their immediate parent).
  replayedFromId BigInt?
  createdAt  DateTime @default(now())

  @@index([webhook, createdAt])
  @@index([replayedFromId])
  @@map("webhook_calls")
}

/// Engine-managed API bearer tokens (dashboard/API credentials).
/// The env master (AUTH_BEARER_TOKEN) is not stored here — it stays in env.
/// Plaintext tokens are NEVER persisted: token_hash is sha256(token), the
/// plaintext is returned exactly once at creation.
model ApiToken {
  id         BigInt    @id @default(autoincrement())
  /// Human-readable label ("ci-deploy", "laptop", …).
  name       String
  /// sha256 hex of the token; the lookup key at auth time. Never exposed by the API.
  tokenHash  String    @unique
  /// First ~10 chars of the plaintext (e.g. "whk_3f9a1c") for display/identification only.
  prefix     String
  /// Null = never expires. Past dates reject the token at auth time.
  expiresAt  DateTime?
  /// Soft revoke: set instead of deleting the row (audit trail).
  revokedAt  DateTime?
  /// Best-effort, throttled (~1/min per token) marker of recent use.
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([name])
  @@map("api_tokens")
}
